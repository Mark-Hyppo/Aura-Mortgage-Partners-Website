---
import Icon from "./Icon.astro";
import { site } from "../data/site";

interface Props {
  variant?: "primary" | "secondary" | "on-dark" | "gold";
  size?: "sm" | "md" | "lg";
  label?: string;
  class?: string;
}

const { variant = "primary", size = "md", label, class: cls = "" } = Astro.props;

const variantClass = {
  primary: "btn-primary",
  secondary: "btn-secondary",
  "on-dark": "btn-on-dark",
  gold: "btn-gold",
}[variant];

const sizeClass = size === "sm" ? "text-base px-6 min-h-[3rem]" : size === "lg" ? "btn-lg" : "";
---

<a
  href={`tel:${site.phoneTel}`}
  data-call-cta
  class={`btn ${variantClass} ${sizeClass} ${cls}`}
>
  <Icon name="phone" class={size === "lg" ? "h-6 w-6" : "h-5 w-5"} />
  {label ?? `Call ${site.phoneDisplay}`}
</a>
