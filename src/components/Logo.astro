---
// The client's own logo, background knocked out to transparency by
// scripts/gen-logo-assets.mjs. It is navy on a light ground, so it needs a LIGHT
// surface, which is why the header and footer are white rather than dark. On the
// old midnight chrome the navy measured 1.18:1 and disappeared entirely.
//
// Two crops of the one supplied file, nothing re-typeset. `full` is the complete
// lockup including "MORTGAGE PARTNERS" and the tagline. `mark` stops after AURA,
// because at any usable header height those two lower lines render a few pixels
// tall and turn to mush.
interface Props {
  class?: string;
  variant?: "mark" | "full";
  /** Rendered height. Width follows the crop's own aspect. */
  size?: "sm" | "md" | "lg";
}

const { class: cls = "", variant = "mark", size = "md" } = Astro.props;

const art =
  variant === "full"
    ? { src: "/logo-full.png", width: 792, height: 760 }
    : { src: "/logo.png", width: 647, height: 520 };

const heights = {
  sm: "h-14",
  md: "h-16 md:h-20",
  lg: "h-32 md:h-40",
};
---

<img
  src={art.src}
  alt="Aura Mortgage Partners"
  width={art.width}
  height={art.height}
  class={`${heights[size]} w-auto ${cls}`}
/>
