---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SectionCta from "../components/SectionCta.astro";
import HeroCanvas from "../components/HeroCanvas.astro";
import heroImage from "../assets/hero.jpg";
import CallButton from "../components/CallButton.astro";
import ProgramCard from "../components/ProgramCard.astro";
import Icon from "../components/Icon.astro";
import Copy from "../components/Copy.astro";
import { site, trustPoints, compliance, isPending, settled } from "../data/site";
import { groups, programsByGroup } from "../data/programs";
import { team } from "../data/team";

const companyNmls = settled(compliance.companyNmls);
const featured = [
  ...programsByGroup("inside").slice(0, 3),
  ...programsByGroup("outside").slice(0, 3),
];
---

<Layout
  title={`Mortgage Broker in ${site.city} | Aura Mortgage Partners`}
  description={`Aura Mortgage Partners provides purchase, refinance, and specialty mortgage financing in ${site.city}, ${site.region}. Contact us at ${site.phoneDisplay}.`}
  pathname="/"
>
  <section class="relative isolate overflow-hidden bg-navy text-white">
    <Image
      src={heroImage}
      alt=""
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    {/* Scrim keeps the centred headline legible over any part of the photo. */}
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_50%_45%,rgba(0,32,80,0.74),rgba(0,22,58,0.93))]"
      aria-hidden="true"
    >
    </div>
    <HeroCanvas />

    <div class="container-page relative pt-10 pb-20 text-center md:pt-14 md:pb-24">
      <div class="mx-auto max-w-4xl" data-hero-content>
      <h1
        class="text-4xl leading-[1.08] font-bold text-balance sm:text-5xl md:text-6xl"
      >
        {site.tagline}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl">
        Aura Mortgage Partners is a Florida mortgage brokerage in {site.city}. We shop your
        scenario across a panel of wholesale lenders, including the ones that write the files a
        retail bank will not.
      </p>

      <div class="btn-stack mt-9">
        <CallButton size="lg" />
        <a href="/loan-programs" class="btn btn-on-dark btn-lg">See loan programs</a>
      </div>

      <p class="mt-6 flex items-center justify-center gap-2 text-sm text-white/70">
        <Icon name="clock" class="h-4 w-4 text-gold" />
        {site.hours}
      </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <h2 class="section-heading">Why borrowers call us instead of a bank</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          trustPoints.map((point) => (
            <div class="card text-center">
              <span class="mx-auto flex h-32 w-32 items-center justify-center rounded-full bg-halo text-brand">
                <Icon name={point.icon} class="h-16 w-16" />
              </span>
              <h3 class="mt-6 font-display text-lg font-semibold">{point.title}</h3>
              <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink/75">{point.desc}</p>
            </div>
          ))
        }
      </div>
      <SectionCta />
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <h2 class="section-heading">Two kinds of files</h2>
      <p class="section-lede mt-4 text-lg leading-relaxed text-ink/75">
        Some loans run straight down the middle of agency guidelines. Others need a lender who
        underwrites the asset, the rents, or the deposits instead of a tax return. We do both.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          (["inside", "outside"] as const).map((key) => (
            <div class="rounded-2xl border border-line bg-halo p-8">
              <h3 class="font-display text-2xl font-semibold">{groups[key].heading}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink/75">{groups[key].desc}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {programsByGroup(key).map((p) => (
                  <li>
                    <a
                      href={`/loan-programs/${p.slug}`}
                      class="inline-block rounded-full border border-line bg-white px-3.5 py-1.5 text-sm font-medium text-ink/80 transition-colors hover:border-brand hover:text-brand"
                    >
                      {p.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((program) => <ProgramCard program={program} />)}
      </div>

      <div class="mt-10 flex justify-center">
        <a href="/loan-programs" class="btn btn-secondary">See all loan programs</a>
      </div>
      <SectionCta />

    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <h2 class="section-heading">The people who structure your file</h2>
      <p class="section-lede mt-4 text-lg leading-relaxed text-ink/75">
        No call center, no handoff. The originator who takes your first call is the one who works
        the file to closing.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          team.map((m) => (
            <a
              href={`/team/${m.slug}`}
              class="card flex items-center gap-5 transition-all hover:-translate-y-0.5 hover:border-brand"
            >
              {settled(m.headshot) ? (
                <img
                  src={settled(m.headshot)}
                  alt={settled(m.headshotAlt)}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-20 w-20 shrink-0 rounded-full object-cover"
                />
              ) : (
                <span class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-full bg-halo font-display text-2xl font-bold text-brand">
                  {m.name.charAt(0)}
                </span>
              )}
              <span class="min-w-0">
                <span class="block font-display text-xl font-semibold">{m.name}</span>
                <span class="block text-sm text-ink/70">{m.title}</span>
                {m.nmls && (
                  <span class="mt-1 block text-sm font-semibold text-brand">
                    NMLS ID# {m.nmls}
                  </span>
                )}
              </span>
            </a>
          ))
        }
      </div>
      <SectionCta />
    </div>
  </section>

  <section class="brand-wash bg-navy text-white">
    <div class="container-page py-16 text-center md:py-20">
      <h2 class="section-heading">Tell us the scenario</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/75">
        Self-employed, foreign national, non-warrantable condo, land only, or perfectly
        straightforward. The first call costs nothing and there is no application to fill out.
      </p>
      <div class="btn-stack mt-8">
        <CallButton />
        <a href="/contact" class="btn btn-on-dark">Send a message</a>
      </div>
      {
        companyNmls && (
          <p class="mt-6 text-sm text-white/60">
            {site.legalName} | Company NMLS ID# {companyNmls}
          </p>
        )
      }
    </div>
  </section>
</Layout>
