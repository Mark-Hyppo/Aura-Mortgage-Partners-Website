---
import Layout from "../../layouts/Layout.astro";
import SectionCta from "../../components/SectionCta.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProgramCard from "../../components/ProgramCard.astro";
import CallButton from "../../components/CallButton.astro";
import { groups, programsByGroup, termOptions } from "../../data/programs";
import { site, compliance } from "../../data/site";
---

<Layout
  title={`Loan Programs | Aura Mortgage Partners | ${site.city}`}
  description={`Aura Mortgage Partners provides conventional, FHA, VA, jumbo, and non-agency loan programs in ${site.city}, ${site.region}. Contact us at ${site.phoneDisplay}.`}
  pathname="/loan-programs"
  breadcrumbs={[{ name: "Loan Programs", href: "/loan-programs" }]}
>
  <PageHeader
    heading="Every program we place, in one list"
    lede="We are a broker, not a bank, so the panel is wide on purpose. Some files run straight down the middle. Others need a lender most originators have never called."
    breadcrumbs={[{ name: "Loan Programs", href: "/loan-programs" }]}
  />

  {
    (["inside", "outside"] as const).map((key, i) => (
      <section class={`section ${i === 1 ? "bg-white" : ""}`}>
        <div class="container-page">
          <h2 class="section-heading">{groups[key].heading}</h2>
          <p class="section-lede mt-4 text-lg leading-relaxed text-ink/75">{groups[key].desc}</p>

          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {programsByGroup(key).map((program) => (
              <ProgramCard program={program} />
            ))}
          </div>
          <SectionCta />
        </div>
      </section>
    ))
  }

  {/*
    Reg Z §1026.24(d)(1): period of repayment is a triggering term. The disclosure
    below must stay adjacent to this list and must never be separated from it.
    Pending compliance sign-off. See COMPLIANCE.md §1.
  */}
  <section class="section">
    <div class="container-page">
      <div class="card">
        <h2 class="font-display text-2xl font-semibold">Repayment terms available</h2>
        <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink/75">
          Depending on the program and the lender, we place loans across these repayment periods.
        </p>

        <ul class="mt-6 flex flex-wrap gap-3">
          {
            termOptions.map((t) => (
              <li class="rounded-full border border-line bg-halo px-5 py-2.5 text-sm font-semibold text-navy">
                {t}
              </li>
            ))
          }
        </ul>

        <p class="mt-6 border-t border-line pt-5 text-xs leading-relaxed text-muted">
          {compliance.regZDisclosure}
        </p>
      </div>
      <SectionCta />
    </div>
  </section>

  <section class="brand-wash bg-navy text-white">
    <div class="container-page py-16 text-center md:py-20">
      <h2 class="section-heading">Not sure which one fits?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/75">
        That is the call to make. Tell us the scenario and we will tell you honestly whether it is a
        straightforward file or one that needs a specialty lender.
      </p>
      <div class="btn-stack mt-8">
        <CallButton />
      </div>
      <p class="mt-4 text-sm text-gold/80">{site.hoursShort}</p>
    </div>
  </section>
</Layout>
