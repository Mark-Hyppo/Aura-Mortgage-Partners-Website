---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionCta from "../components/SectionCta.astro";
import { site, compliance } from "../data/site";
import { TERM_OPTIONS } from "../lib/mortgage";

// The interest rate ships EMPTY on purpose. Every other field is plainly the
// borrower's own figure; a rate pre-filled by the broker reads as a rate the
// broker is offering, which is a triggering term under Reg Z §1026.24(d)(1) and
// pulls in the full §1026.24(d)(2) disclosure set. See COMPLIANCE.md.
// The annual tax default is a property-tax estimate, not a credit term.
const crumbs = [{ name: "Mortgage Calculator", href: "/mortgage-calculator" }];

const fields = [
  { id: "price", label: "Purchase price", unit: "$", value: "", placeholder: "500,000", step: "1000" },
  { id: "down", label: "Down payment", unit: "$", value: "", placeholder: "100,000", step: "1000" },
  { id: "rate", label: "Interest rate", unit: "%", value: "", placeholder: "Rate you want to model", step: "0.125" },
  { id: "tax", label: "Annual property tax", unit: "%", value: "1", placeholder: "1", step: "0.1" },
  { id: "insurance", label: "Annual insurance", unit: "$", value: "", placeholder: "2,400", step: "100" },
  { id: "hoa", label: "Monthly HOA dues", unit: "$", value: "", placeholder: "0", step: "25" },
];
---

<Layout
  title={`Mortgage Calculator | Aura Mortgage Partners | ${site.city}`}
  description={`Estimate a monthly mortgage payment using your own figures. Aura Mortgage Partners, ${site.city}, ${site.region}. Call ${site.phoneDisplay}.`}
  pathname="/mortgage-calculator"
  breadcrumbs={crumbs}
>
  <PageHeader
    heading="Mortgage calculator"
    lede="Enter your own figures to see what a monthly payment could look like. Everything here is an estimate. The numbers that matter come from an application."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-14">
        <form id="calc" novalidate class="card">
          <h2 class="section-heading section-heading--left text-2xl">Your figures</h2>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {
              fields.map((f) => (
                <div>
                  <label for={f.id} class="block text-sm font-semibold text-ink/80">
                    {f.label}
                  </label>
                  <div class="field mt-2">
                    <span aria-hidden="true" class="field-unit">
                      {f.unit}
                    </span>
                    <input
                      id={f.id}
                      name={f.id}
                      type="number"
                      inputmode="decimal"
                      min="0"
                      step={f.step}
                      value={f.value}
                      placeholder={f.placeholder}
                      autocomplete="off"
                    />
                  </div>
                </div>
              ))
            }

            <div>
              <label for="term" class="block text-sm font-semibold text-ink/80">Loan term</label>
              <div class="field mt-2">
                <select id="term" name="term">
                  {
                    TERM_OPTIONS.map((years) => (
                      <option value={years} selected={years === 30}>
                        {years} years
                      </option>
                    ))
                  }
                </select>
              </div>
            </div>
          </div>

          <p class="mt-8 text-sm text-muted">
            Results update as you type. Nothing you enter leaves your browser.
          </p>
        </form>

        <aside class="lg:sticky lg:top-8 lg:self-start">
          <div class="rounded-2xl border border-line bg-white p-7 text-center">
            <h2 class="text-xs font-semibold tracking-wider text-muted uppercase">
              Estimated monthly payment
            </h2>
            <p
              id="out-total"
              class="mt-3 font-display text-5xl font-bold text-navy tabular-nums"
            >
              -
            </p>

            <dl class="mt-8 space-y-3.5 text-left">
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-sm text-ink/75">Principal &amp; interest</dt>
                <dd id="out-pi" class="text-base font-semibold tabular-nums">-</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-sm text-ink/75">Property taxes</dt>
                <dd id="out-tax" class="text-base font-semibold tabular-nums">-</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-sm text-ink/75">Insurance</dt>
                <dd id="out-ins" class="text-base font-semibold tabular-nums">-</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-sm text-ink/75">HOA dues</dt>
                <dd id="out-hoa" class="text-base font-semibold tabular-nums">-</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-t border-line pt-3.5">
                <dt class="text-sm font-semibold">Amount financed</dt>
                <dd id="out-principal" class="text-base font-semibold tabular-nums">-</dd>
              </div>
            </dl>

            <p id="out-hint" class="mt-7 text-sm text-muted">
              Enter a purchase price and an interest rate to see an estimate.
            </p>
          </div>
        </aside>
      </div>

      <div class="mx-auto mt-12 max-w-4xl space-y-4 rounded-2xl border border-line bg-halo p-7">
        <h2 class="font-display text-base font-semibold">About this estimate</h2>
        <p class="text-sm leading-relaxed text-ink/80">
          This calculator uses only the figures you enter. It is an illustration, not a quote, an
          offer, or an approval, and Aura Mortgage Partners is not quoting a rate here. The estimate
          excludes mortgage insurance (PMI or MIP), flood insurance, closing costs, and prepaid
          items, any of which may apply to your loan.
        </p>
        <p class="text-sm leading-relaxed text-ink/80">{compliance.regZDisclosure}</p>
        <p class="text-sm leading-relaxed text-ink/80">{compliance.disclaimer}</p>
      </div>
    </div>

    <SectionCta />
  </section>
</Layout>

<script>
  import { calculate, formatUsd } from "../lib/mortgage";

  const form = document.getElementById("calc") as HTMLFormElement | null;
  if (form) {
    const num = (id: string) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      const v = Number(el?.value);
      return Number.isFinite(v) ? v : 0;
    };
    const setText = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    const render = () => {
      const price = num("price");
      const ratePct = num("rate");

      const r = calculate({
        price,
        downPayment: num("down"),
        ratePct,
        termYears: num("term"),
        taxPct: num("tax"),
        annualInsurance: num("insurance"),
        monthlyHoa: num("hoa"),
      });

      // A price with no rate would render a payment implying 0% interest, which
      // is both wrong and a number we should never show. Hold the output instead.
      const ready = price > 0 && ratePct > 0;

      setText("out-total", ready ? formatUsd(r.total) : "-");
      setText("out-pi", ready ? formatUsd(r.principalAndInterest) : "-");
      setText("out-tax", ready ? formatUsd(r.monthlyTaxes) : "-");
      setText("out-ins", ready ? formatUsd(r.monthlyInsurance) : "-");
      setText("out-hoa", ready ? formatUsd(r.monthlyHoa) : "-");
      setText("out-principal", ready ? formatUsd(r.principal) : "-");

      const hint = !price
        ? "Enter a purchase price and an interest rate to see an estimate."
        : !ratePct
          ? "Enter the interest rate you want to model."
          : r.principal === 0
            ? "Your down payment covers the full purchase price, so there is nothing to finance."
            : "Estimate only. Excludes mortgage insurance, flood insurance, and closing costs.";
      setText("out-hint", hint);
    };

    form.addEventListener("input", render);
    form.addEventListener("change", render);
    form.addEventListener("submit", (e) => e.preventDefault());
    render();
  }
</script>
