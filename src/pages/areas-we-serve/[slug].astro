---
import Layout from "../../layouts/Layout.astro";
import SectionCta from "../../components/SectionCta.astro";
import PageHeader from "../../components/PageHeader.astro";
import CallButton from "../../components/CallButton.astro";
import ProgramCard from "../../components/ProgramCard.astro";
import { areas, programsForArea, type Area } from "../../data/areas";
import { site, compliance, isPending } from "../../data/site";
import { team } from "../../data/team";

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const localPrograms = programsForArea(area);

// Nearest other areas, so each page links laterally rather than only up.
const nearby = areas
  .filter((a) => a.slug !== area.slug)
  .sort((a, b) => Math.abs(a.miles - area.miles) - Math.abs(b.miles - area.miles))
  .slice(0, 4);

// No "Areas We Serve" crumb, because there is no index page behind it. The header
// dropdown is the only entry point into the city pages.
const crumbs = [{ name: area.city, href: `/areas-we-serve/${area.slug}` }];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: area.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title={`Mortgage Broker in ${area.city}, FL | Aura Mortgage Partners`}
  description={`Mortgage broker serving ${area.city}, Florida. Aura Mortgage Partners shops your scenario across wholesale lenders. Call ${site.phoneDisplay}.`}
  pathname={`/areas-we-serve/${area.slug}`}
  breadcrumbs={crumbs}
>
  <PageHeader
    heading={`Mortgage financing in ${area.city}`}
    lede={area.blurb}
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-16">
      <div>
        <h2 class="font-display text-2xl font-semibold">
          What shapes a {area.city} file
        </h2>
        <p class="mt-5 leading-relaxed text-ink/85">{area.conditions}</p>

        <h2 class="mt-14 font-display text-2xl font-semibold">
          Programs that come up most in {area.city}
        </h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {localPrograms.map((p) => <ProgramCard program={p} />)}
        </div>

        <h2 class="mt-14 font-display text-2xl font-semibold">Common questions</h2>
        <dl class="mt-6 divide-y divide-line border-t border-line">
          {
            area.faq.map((f) => (
              <div class="py-6">
                <dt class="font-display text-lg font-semibold text-navy">{f.q}</dt>
                <dd class="mt-3 text-[0.9375rem] leading-relaxed text-ink/75">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <aside class="lg:sticky lg:top-8 lg:self-start">
        <div class="card">
          <h2 class="font-display text-xl font-semibold">Talk through a {area.city} scenario</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink/75">
            Five minutes on the phone will tell you more than an hour of reading. No application
            required to ask.
          </p>
          <CallButton class="mt-6 w-full" size="sm" />
          <p class="mt-3 text-center text-sm text-muted">{site.hoursShort}</p>

          <ul class="mt-6 space-y-2 border-t border-line pt-5">
            {
              team.map((m) => (
                <li class="text-sm text-ink/70">
                  <a href={`/team/${m.slug}`} class="font-semibold hover:text-brand">
                    {m.name}
                  </a>
                  {!isPending(m.nmls) && m.nmls && <span>, NMLS ID# {m.nmls}</span>}
                </li>
              ))
            }
          </ul>
        </div>

        <p class="mt-5 text-xs leading-relaxed text-muted">{compliance.disclaimer}</p>
      </aside>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <h2 class="section-heading">Also serving nearby</h2>
      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {
          nearby.map((a) => (
            <li>
              <a
                href={`/areas-we-serve/${a.slug}`}
                class="inline-block rounded-full border border-line bg-halo px-5 py-2.5 text-[0.9375rem] font-semibold text-ink/80 transition-colors hover:border-brand hover:text-brand"
              >
                {a.city}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-relaxed text-muted">
        Licensed in {compliance.statesLicensed}. This list is not exhaustive. If your property is
        elsewhere in the state, call and ask.
      </p>

      <SectionCta />
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Layout>
