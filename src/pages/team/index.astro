---
import Layout from "../../layouts/Layout.astro";
import SectionCta from "../../components/SectionCta.astro";
import PageHeader from "../../components/PageHeader.astro";
import CallButton from "../../components/CallButton.astro";
import Copy from "../../components/Copy.astro";
import Icon from "../../components/Icon.astro";
import { site, compliance, isPending, settled } from "../../data/site";
import { team } from "../../data/team";

const crumbs = [{ name: "Our Team", href: "/team" }];
---

<Layout
  title={`Loan Officers | Aura Mortgage Partners | ${site.city}`}
  description={`Aura Mortgage Partners provides licensed mortgage loan originators in ${site.city}, ${site.region}. Contact us at ${site.phoneDisplay}.`}
  pathname="/team"
  breadcrumbs={crumbs}
>
  <PageHeader
    heading="Our loan officers"
    lede="Two licensed originators, both reachable by phone. Verify either license at nmlsconsumeraccess.org."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="container-page grid gap-8 md:grid-cols-2">
      {
        team.map((m) => (
          <article class="card flex flex-col">
            <div class="flex items-center gap-5">
              {settled(m.headshot) ? (
                <img
                  src={settled(m.headshot)}
                  alt={settled(m.headshotAlt)}
                  width="96"
                  height="96"
                  class="h-24 w-24 rounded-full object-cover"
                />
              ) : (
                <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-halo font-display text-3xl font-bold text-brand">
                  {m.name.charAt(0)}
                </span>
              )}
              <div class="min-w-0">
                <h2 class="font-display text-2xl font-semibold">{m.name}</h2>
                <p class="text-sm text-ink/70">{m.title}</p>
                {m.nmls && (
                  <p class="mt-1 text-sm font-bold text-brand">NMLS ID# {m.nmls}</p>
                )}
              </div>
            </div>

            <ul class="mt-6 flex flex-wrap gap-2">
              {m.specialties.map((s) => (
                <li class="rounded-full border border-line bg-halo px-3 py-1.5 text-xs font-semibold text-ink/75">
                  {s}
                </li>
              ))}
            </ul>

            <div class="mt-auto flex flex-wrap items-center gap-4 pt-7">
              <a
                href={`/team/${m.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand"
              >
                Read bio
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
              <a
                href={`tel:${site.phoneTel}`}
                data-call-cta
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy hover:text-brand"
              >
                <Icon name="phone" class="h-4 w-4" />
                {site.phoneDisplay}
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <SectionCta />

    <div class="container-page mt-10">
      <p class="text-sm text-muted">
        Verify licensing at{" "}
        <a
          href={compliance.verifyUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="font-semibold text-brand underline underline-offset-2"
          >{compliance.verifyLabel}</a
        >.
      </p>
    </div>
  </section>

  <section class="brand-wash bg-navy text-white">
    <div class="container-page py-16 text-center md:py-20">
      <h2 class="section-heading">One call reaches both</h2>
      <div class="btn-stack mt-8"><CallButton /></div>
      <p class="mt-4 text-sm text-gold/80">{site.hoursShort}</p>
    </div>
  </section>
</Layout>
