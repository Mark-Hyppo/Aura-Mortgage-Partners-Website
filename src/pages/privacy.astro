---
import Layout from "../layouts/Layout.astro";
import SectionCta from "../components/SectionCta.astro";
import PageHeader from "../components/PageHeader.astro";
import Copy from "../components/Copy.astro";
import { site, settled } from "../data/site";

const email = settled(site.email);
const updated = "August 4, 2026";
---

<Layout
  title={`Privacy Policy | Aura Mortgage Partners | ${site.city}`}
  description={`Aura Mortgage Partners provides mortgage brokerage services in ${site.city}, ${site.region}. Contact us at ${site.phoneDisplay}.`}
  pathname="/privacy"
  breadcrumbs={[{ name: "Privacy Policy", href: "/privacy" }]}
>
  <PageHeader heading="Privacy Policy" breadcrumbs={[{ name: "Privacy Policy", href: "/privacy" }]} />

  <section class="section">
    <div class="container-page">
      <div class="prose-legal">
        <p class="text-sm font-semibold text-muted">Last updated: {updated}</p>

        <p>
          This Privacy Policy describes how {site.legalName} (&ldquo;Company,&rdquo; &ldquo;we,&rdquo;
          &ldquo;us,&rdquo; or &ldquo;our&rdquo;) collects, uses, and shares information when you
          visit our website, contact us, request a quote or estimate, schedule services, or
          otherwise interact with us.
        </p>

        <h2>Information We Collect</h2>
        <p>
          We may collect personal information you voluntarily provide to us, including your name,
          phone number, email address, mailing address, and other contact details. We may also
          collect information related to your requested services, including project details, item or
          vehicle information, photos, measurements, notes, preferences, and scheduling details. In
          addition, we may collect records of communications with you, including emails, phone
          calls, text messages, chat messages, voicemails, and call recordings where permitted. When
          you use our website, we may also collect certain usage data such as your IP address,
          browser type, device information, pages viewed, referring pages, and similar analytics
          data.
        </p>

        <h2>How We Use Information</h2>
        <p>
          We use your information to provide quotes, estimates, and requested services, to schedule
          appointments and send reminders, and to communicate with you about service updates,
          project coordination, and customer support. We may also use your information to improve
          our website, services, and internal business operations, to maintain security and prevent
          fraud or misuse, and to comply with legal obligations and enforce our policies.
        </p>

        <h2>Text Messaging (SMS) and Phone Communications</h2>
        <p>
          If you provide your phone number and consent to receive text messages, you may receive SMS
          or phone communications from us related to appointment scheduling and reminders, quote or
          estimate follow-up, service updates and coordination, customer support, and review
          requests or follow-up communications. Message frequency may vary, and message and data
          rates may apply. You can opt out of text messages at any time by replying STOP. For help,
          reply HELP or contact us using the contact information listed below. Consent to receive
          text messages is not a condition of purchase.
        </p>

        <h2>How We Share Information</h2>
        <p>
          We may share your information with trusted third-party service providers that help us
          operate our business, such as phone and SMS providers, email providers, CRM and scheduling
          platforms, website hosting providers, analytics providers, and payment processors. These
          providers may only use your information as needed to provide services on our behalf and
          must protect it appropriately. We do not sell your personal information. No mobile
          information will be shared with third parties or affiliates for marketing or promotional
          purposes. Text messaging opt-in data and consent will not be shared with any third
          parties, except as necessary to provide messaging services.
        </p>

        <h2>Cookies and Analytics</h2>
        <p>
          We may use cookies, pixels, and similar technologies to improve website functionality,
          understand user activity, and enhance the user experience. You can manage cookie
          preferences through your browser settings.
        </p>

        <h2>Data Security</h2>
        <p>
          We use reasonable administrative, technical, and physical safeguards to protect your
          information. However, no method of transmission over the internet or electronic storage is
          completely secure, and we cannot guarantee absolute security.
        </p>

        <h2>Data Retention</h2>
        <p>
          We retain personal information for as long as needed to provide services, comply with
          legal obligations, resolve disputes, and enforce our agreements.
        </p>

        <h2>Your Choices</h2>
        <p>
          You may request access to the personal information we hold about you, request correction or
          deletion of your information subject to legal and operational requirements, opt out of
          marketing emails by using the unsubscribe link if applicable, and opt out of text messages
          at any time by replying STOP.
        </p>

        <h2>Contact Us</h2>
        <p>
          If you have any questions about this Privacy Policy or our privacy practices, you may
          contact us at:
        </p>
        <address class="mt-4 text-[0.9375rem] leading-relaxed text-ink/85 not-italic">
          {site.legalName}<br />
          {settled(site.street) && <>{settled(site.street)}<br /></>}
          {site.city}, {site.region} {settled(site.postal)}<br />
          <a href={`tel:${site.phoneTel}`} class="font-semibold hover:text-brand"
            >{site.phoneDisplay}</a
          ><br />
          {
            email ? (
              <a href={`mailto:${email}`} class="font-semibold hover:text-brand">
                {email}
              </a>
            ) : (
              <Copy value={site.email} as="span" />
            )
          }
        </address>
      </div>
      <SectionCta />
    </div>
  </section>
</Layout>
